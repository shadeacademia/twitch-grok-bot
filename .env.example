# Twitch chat account that joins the channel. Mod this account or timeouts do nothing.
TWITCH_NICK=your_bot_login
TWITCH_OAUTH=oauth:paste_the_token_here
TWITCH_CHANNEL=your_channel_login

# Logins allowed to !allow / !unallow. Defaults to the channel login.
# TWITCH_OWNERS=your_channel_login

# SuperGrok goes through the grok CLI already signed in on this machine.
# GROK_MODEL=grok-4.7-build-fast
# GROK_EFFORT=low
# suspect (default) only sends odd messages to Grok. all judges every message.
# GROK_AUTOMOD=suspect
# ALLOW_LINKS=0
# REPLY_ALL_WHITELIST=0
